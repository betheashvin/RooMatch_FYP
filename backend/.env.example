# Copy to backend/.env and paste the PostgreSQL connection string from Neon's Connect dialog.
# This is a database connection string, not a Neon API key. Keep it on the backend.
# A standard postgresql:// URL is accepted and uses the psycopg 3 driver.
# Keep sslmode=require (and channel_binding if supplied by Neon) in the URL.
# Example: DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Local PostgreSQL works through the same setting, for example:
# DATABASE_URL=postgresql://roomatch:PASSWORD@127.0.0.1:5432/roomatch

# Alternatively, omit DATABASE_URL and set standard PostgreSQL variables:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=roomatch
# PGUSER=roomatch
# PGPASSWORD=YOUR_PASSWORD
# PGSSLMODE=prefer

# Email OTP verification (SMTP defaults to STARTTLS on port 587).
EMAIL_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true
# For local development ONLY: EMAIL_DELIVERY=console prints OTPs in API logs.

# Use true with HTTPS in production. Keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
