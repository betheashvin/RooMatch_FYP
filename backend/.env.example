# This is a database connection string, not a Neon API key. Keep it on the backend.
DATABASE_URL=

# Email OTP verification (SMTP defaults to STARTTLS on port 587).
EMAIL_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true
# For local development ONLY: EMAIL_DELIVERY=console prints OTPs in API logs.

# Use true with HTTPS in production. Keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
